{
    "name": "@nfwyst/pinets",
    "version": "0.11.1-nfwyst.8",
    "description": "The nfwyst-maintained PineTS fork for running Pine Script indicators and strategies in Node.js and the browser.",
    "keywords": [
        "Pine Script",
        "Pine",
        "PineScript transpiler",
        "PineScript runtime",
        "PineScript to JavaScript",
        "PineScript to TypeScript",
        "TradingView",
        "Quant",
        "Quantitative Finance",
        "Trading",
        "Technical Analysis",
        "TA",
        "Indicator",
        "Strategy",
        "Backtesting",
        "Forecasting",
        "Machine Learning",
        "Data Science",
        "Data Analysis",
        "Data Visualization",
        "Data Mining"
    ],
    "main": "dist/pinets.min.cjs",
    "module": "dist/pinets.min.es.js",
    "browser": "dist/pinets.min.browser.es.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": {
                "import": "./dist/types/index.d.ts",
                "require": "./dist/types/cjs/index.d.ts"
            },
            "node": {
                "import": "./dist/pinets.min.es.js",
                "require": "./dist/pinets.min.cjs"
            },
            "browser": {
                "import": "./dist/pinets.min.browser.es.js",
                "default": "./dist/pinets.min.browser.js"
            },
            "default": "./dist/pinets.min.es.js"
        }
    },
    "files": [
        "dist/*.min.*",
        "dist/types"
    ],
    "type": "module",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "test": "TEST_ENV=true bunx --bun vitest --reporter verbose",
        "test:ci": "TEST_ENV=true PINETS_OFFLINE_TESTS=true TZ=UTC bunx --bun vitest run --reporter dot --silent=passed-only",
        "test:live": "TEST_ENV=true TZ=UTC bunx --bun vitest run tests/core/livestream.test.ts tests/namespaces/request-streaming.test.ts --reporter dot --silent=passed-only",
        "typecheck": "bunx --bun tsc --noEmit -p tsconfig.dts.json",
        "test:coverage": "TEST_ENV=true bunx --bun vitest run --coverage",
        "test:coverage:badge": "TEST_ENV=true bunx --bun vitest run --coverage --exclude tests/_local/**",
        "generate:badges": "bun run test:coverage:badge && bun run scripts/generate-badges.js",
        "generate:ta-index": "bun run scripts/generate-ta-index.js",
        "generate:math-index": "bun run scripts/generate-math-index.js",
        "generate:array-index": "bun run scripts/generate-array-index.js",
        "generate:input-index": "bun run scripts/generate-input-index.js",
        "generate:request-index": "bun run scripts/generate-request-index.js",
        "generate:map-index": "bun run scripts/generate-map-index.js",
        "generate:matrix-index": "bun run scripts/generate-matrix-index.js",
        "build:dev:all": "bun run generate:ta-index && bun run generate:math-index && bun run generate:array-index && bun run generate:input-index && bun run generate:request-index && bun run generate:map-index && bun run generate:matrix-index && bun run build:dev:browser && bun run build:dev:cjs && bun run build:dev:es && bun run build:dev:browser-es && bunx --bun tsc --emitDeclarationOnly --declaration --outDir dist/types -p tsconfig.dts.json && bun run scripts/prepare-declarations.js",
        "build:dev:cjs": "BUILD=dev FORMAT=cjs bunx --bun rollup -c ./rollup.config.js",
        "build:dev:browser": "BUILD=dev FORMAT=browser bunx --bun rollup -c ./rollup.config.js",
        "build:dev:browser-es": "BUILD=dev FORMAT=browser-es bunx --bun rollup -c ./rollup.config.js",
        "build:dev:es": "BUILD=dev bunx --bun rollup -c ./rollup.config.js",
        "build:prod:all": "bun run generate:ta-index && bun run generate:math-index && bun run generate:array-index && bun run generate:input-index && bun run generate:request-index && bun run generate:map-index && bun run generate:matrix-index && bun run build:prod:browser && bun run build:prod:cjs && bun run build:prod:es && bun run build:prod:browser-es && bunx --bun tsc --emitDeclarationOnly --declaration --outDir dist/types -p tsconfig.dts.json && bun run scripts/prepare-declarations.js",
        "build:prod:cjs": "BUILD=prod FORMAT=cjs bunx --bun rollup -c ./rollup.config.js",
        "build:prod:browser": "BUILD=prod FORMAT=browser bunx --bun rollup -c ./rollup.config.js",
        "build:prod:browser-es": "BUILD=prod FORMAT=browser-es bunx --bun rollup -c ./rollup.config.js",
        "build:prod:es": "BUILD=prod bunx --bun rollup -c ./rollup.config.js",
        "prepublishOnly": "bun run build:prod:all",
        "knip": "bunx --bun knip"
    },
    "author": "LuxAlgo",
    "license": "AGPL-3.0-only",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "acorn": "^8.14.0",
        "acorn-walk": "^8.3.4",
        "astring": "^1.9.0"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "@vitest/coverage-v8": "^4.1.0",
        "autoprefixer": "^10.4.23",
        "badgen": "^3.2.3",
        "knip": "^5.43.6",
        "postcss": "^8.5.6",
        "rollup-plugin-esbuild": "^6.2.1",
        "rollup-plugin-sourcemaps": "^0.6.3",
        "rollup-plugin-typescript-paths": "^1.5.0",
        "tailwindcss": "^4.1.18",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vite-tsconfig-paths": "^4.3.2",
        "vitest": "^4.1.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nfwyst/PineTS.git"
    },
    "bugs": {
        "url": "https://github.com/nfwyst/PineTS/issues"
    },
    "homepage": "https://github.com/nfwyst/PineTS#readme"
}
